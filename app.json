{
  "expo": {
    "name": "Dive Log Transfer",
    "slug": "dive-log-transfer",
    "version": "0.2.0",
    "scheme": "divelogtransfer",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divelogtransfer.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.divelogtransfer.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B3B46"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "enabled": false
    }
  }
}
