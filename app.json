{
  "expo": {
    "name": "Garmin to MySSI",
    "slug": "garmin-to-myssi",
    "version": "0.4.2",
    "scheme": "divelogtransfer",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divelogtransfer.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.divelogtransfer.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B3B46"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "enabled": false
    }
  }
}
