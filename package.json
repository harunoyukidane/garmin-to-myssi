{
  "name": "dive-log-transfer",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:android": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:ios": "npx eas-cli build --platform ios --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/register.cjs --test tests/*.test.cjs",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "native:generate:android": "expo prebuild --platform android",
    "native:generate:ios": "expo prebuild --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@garmin/fitsdk": "21.218.0",
    "@react-navigation/elements": "2.2.5",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-document-picker": "~13.0.1",
    "expo-file-system": "~18.0.12",
    "expo-secure-store": "~14.0.1",
    "fflate": "^0.8.2",
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "jsqr": "1.4.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "@react-navigation/elements": "2.2.5"
  }
}
